{
	"type": "commonjs",
	"name": "jab-express",
	"version": "1.0.0",
	"scripts": {
		"start": "ts-node src/index.ts",
		"dev": "cross-env NODE_ENV=development nodemon src/index.ts",
		"build": "rimraf dist && tsc",
		"lint": "eslint \"src/**/*.{ts,tsx,js}\" \"db/**/*.ts\" --fix",
		"serve": "node dist/index.js",
		"format": "prettier --write \"src/**/*.{ts,tsx,js}\"",
		"db:push": "drizzle-kit push --config=drizzle.config.ts",
		"db:generate": "drizzle-kit generate --config=drizzle.config.ts",
		"db:studio": "drizzle-kit studio",
		"db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
		"db:seed": "tsx ./db/seed.ts",
		"db:reset": "tsx ./db/reset.ts",
		"openapi:generate": "npm run build && node scripts/generate-openapi.js",
		"openapi:validate": "npm run openapi:generate",
		"types:generate": "npm run openapi:generate",
		"generate:types": "node ../scripts/generate-all-types.js"
	},
	"author": "",
	"license": "ISC",
	"description": "",
	"dependencies": {
		"@ai-sdk/openai": "^2.0.52",
		"@profiller-hr/shared-types": "file:../shared-types",
		"@types/jsonwebtoken": "^9.0.10",
		"ai": "^5.0.76",
		"axios": "^1.12.2",
		"bcrypt": "^6.0.0",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.5",
		"dotenv": "^17.2.3",
		"drizzle-kit": "^0.31.5",
		"drizzle-orm": "^0.44.6",
		"drizzle-zod": "^0.8.3",
		"express": "^5.1.0",
		"express-rate-limit": "^8.1.0",
		"express-slow-down": "^3.0.0",
		"express-validator": "^7.2.1",
		"helmet": "^8.1.0",
		"inversify": "^7.10.3",
		"ioredis": "^5.8.1",
		"jose": "^6.1.0",
		"jsonwebtoken": "^9.0.2",
		"lodash.merge": "^4.6.2",
		"morgan": "^1.10.1",
		"next-auth": "^4.24.11",
		"nodemailer": "^7.0.9",
		"pg": "^8.16.3",
		"pg-hstore": "^2.3.4",
		"prom-client": "^15.1.3",
		"reflect-metadata": "^0.2.2",
		"rimraf": "^6.0.1",
		"sequelize": "^6.37.7",
		"swagger-jsdoc": "^6.2.8",
		"swagger-ui-express": "^5.0.1",
		"ts-node": "^10.9.2",
		"typescript": "^5.9.3",
		"zod": "^4.1.12"
	},
	"devDependencies": {
		"@eslint/js": "^9.38.0",
		"@faker-js/faker": "^10.1.0",
		"@types/bcrypt": "^6.0.0",
		"@types/cookie-parser": "^1.4.9",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.3",
		"@types/lodash.merge": "^4.6.9",
		"@types/morgan": "^1.9.10",
		"@types/node": "^24.8.1",
		"@types/nodemailer": "^7.0.2",
		"@types/pg": "^8.15.5",
		"@types/swagger-jsdoc": "^6.0.4",
		"@types/swagger-ui-express": "^4.1.8",
		"@types/uuid": "^10.0.0",
		"@typescript-eslint/eslint-plugin": "^8.46.1",
		"@typescript-eslint/parser": "^8.46.1",
		"cross-env": "^10.1.0",
		"eslint": "^9.38.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.4",
		"globals": "^16.4.0",
		"i": "^0.3.7",
		"nodemon": "^3.1.10",
		"npm": "^11.6.2",
		"prettier": "^3.6.2",
		"tsx": "^4.20.6",
		"typescript-eslint": "^8.46.1"
	}
}
