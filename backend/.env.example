# Backend Environment Variables

# Database URL for migrations and backend connection
# When running migrations from host machine (outside Docker)
DATABASE_URL=postgresql://postgres:admin@localhost:5433/profiller_dev

# When running from within Docker container
# DATABASE_URL=postgresql://postgres:admin@postgres:5432/profiller_dev

# Database connection details (used by Docker Compose)
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=admin
DB_NAME=profiller_dev

# Authentication - Legacy JWT (for API endpoints)
JWT_SECRET=dev-jwt-secret-key
JWT_EXPIRES_IN=7d

# NextAuth Integration (for session validation)
NEXTAUTH_SECRET=your-nextauth-secret-key-here-must-match-frontend
NEXTAUTH_URL=http://localhost:3000

# Frontend URL Configuration
FRONTEND_URL=http://localhost:3000

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# Security Headers
INTERNAL_API_SECRET=your-internal-api-secret-for-backend-communication

# Environment
NODE_ENV=development
LOG_LEVEL=debug
PORT=3001 


OPENAI_API_KEY=token

# Technical Authentication Tokens
TECHNICAL_TOKENS='{"frontend":"tech_frontend_dev_1dd8ac18d0f4591cff40c057735ebd7b10c2d389e3fd1f12269d8f43ac867629","mcp-server":"tech_mcp-server_dev_9df1c6c6db3a8e767801e1052b04364c12fdf228746ee0b5e76b395030d9a061","admin-scripts":"tech_admin-scripts_dev_0787fd9ba320cc75325635d8b1ee105b7399720d78c3239de676724a3833d685","monitoring":"tech_monitoring_dev_b0864534da70ad94974fdf2d6bcb077d1499951e0e83f935f2d20784201b9a90"}'

# Client Credentials for Technical Token Generation
CLIENT_ID=hr-profiller-api-client
CLIENT_SECRET=dev-client-secret-for-technical-tokens-2024
